rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }

    // Public profile. Anyone signed in can look people up by username.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'photoURL', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 64
        && getAfter(docPath('usernames', request.resource.data.username)).data.uid == uid;

      // Links you've archived from your tab groups, one document per message. Only you see them.
      match /archivedLinks/{id} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['roomId', 'messageId', 'urls', 'updatedAt'])
          && request.resource.data.roomId is string
          && request.resource.data.messageId is string
          && id == request.resource.data.roomId + ':' + request.resource.data.messageId
          && request.resource.data.urls is list
          && request.resource.data.urls.size() >= 1
          && request.resource.data.urls.size() <= 50
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Username reservations. The document ID is the lowercase username.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(docPath('users', request.auth.uid)).data.username == name;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(docPath('users', request.auth.uid)).data.username != name;
    }

    // One document per pair of users, ID = "<smallerUid>_<largerUid>".
    match /friendships/{id} {
      // Checked by ID so a user can look up a pair that doesn't exist yet.
      allow get: if signedIn() && request.auth.uid in id.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'requester', 'status', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && id == pairId(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Only the person who received the request can accept it.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.requester != request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted';

      // Either side can decline, cancel, or unfriend.
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    function myEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function onlyMyKey(after, before) {
      return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
    }

    function roomPath(roomId) {
      return docPath('rooms', roomId);
    }

    function isInvited(room) {
      return request.auth.uid in room.invited || myEmail() in room.invitedEmails;
    }

    function isDirect(room) {
      return room.get('kind', 'group') == 'direct';
    }

    // Checked after the write, so accepting a request and creating the chat can share a batch.
    function friendsAfter(a, b) {
      let path = docPath('friendships', pairId(a, b));
      return existsAfter(path) && getAfter(path).data.status == 'accepted';
    }

    // A chat room. Group rooms: members chat; invitees (by uid or by email) can see the room and join it.
    // Direct rooms: one per pair of friends, ID = "dm_<smallerUid>_<largerUid>", exactly those two members.
    match /rooms/{roomId} {
      allow list: if signedIn()
        && (request.auth.uid in resource.data.members || isInvited(resource.data));
      // A direct room can be checked by ID before it exists, so either friend can create it if missing.
      allow get: if signedIn()
        && ((roomId.matches('^dm_[^_]+_[^_]+$') && request.auth.uid in roomId.split('_'))
            || request.auth.uid in resource.data.members
            || isInvited(resource.data));

      allow create: if signedIn() && (
        roomId.matches('^dm_.*') ? validDirect(request.resource.data) : validGroup(request.resource.data)
      );

      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
          ? memberUpdate(request.resource.data, resource.data)
          : (!isDirect(resource.data)
              && (join(request.resource.data, resource.data) || decline(request.resource.data, resource.data)))
      );

      // The last member to leave deletes a group room. A direct room goes when the friendship does.
      allow delete: if signedIn() && (
        isDirect(resource.data)
          ? request.auth.uid in resource.data.members
            && !friendsAfter(resource.data.members[0], resource.data.members[1])
          : resource.data.members == [request.auth.uid]
      );

      function roomKeys(data) {
        return data.keys().hasOnly([
          'kind', 'name', 'createdBy', 'createdAt', 'members', 'invited', 'invitedEmails',
          'joinCode', 'lastMessage', 'lastMessageAt', 'readAt'
        ]);
      }

      function validDirect(data) {
        return roomKeys(data)
          && data.kind == 'direct'
          && data.name == ''
          && data.createdBy == request.auth.uid
          && data.createdAt == request.time
          && data.members is list
          && data.members.size() == 2
          && request.auth.uid in data.members
          && roomId == 'dm_' + pairId(data.members[0], data.members[1])
          && friendsAfter(data.members[0], data.members[1])
          && data.invited == []
          && data.invitedEmails == []
          && data.joinCode == null
          && data.lastMessage == null
          && data.lastMessageAt == request.time
          && data.readAt.keys().hasOnly(data.members);
      }

      function validGroup(data) {
        return roomKeys(data)
          && data.kind == 'group'
          && validName(data.name)
          && data.createdBy == request.auth.uid
          && data.createdAt == request.time
          && data.members == [request.auth.uid]
          && validInvites(data)
          && data.lastMessage == null
          && data.lastMessageAt == request.time
          && data.readAt.keys().hasOnly([request.auth.uid])
          && validCode(data.joinCode)
          && getAfter(docPath('roomCodes', data.joinCode)).data.roomId == roomId;
      }

      function validName(name) {
        return name is string && name.size() >= 1 && name.size() <= 64;
      }

      function validCode(code) {
        return code is string && code.matches('^[A-Z2-9]{10}$');
      }

      function validInvites(data) {
        return data.invited is list && data.invited.size() <= 50
          && data.invitedEmails is list && data.invitedEmails.size() <= 50;
      }

      function changed(after, before) {
        return after.diff(before).affectedKeys();
      }

      function memberUpdate(after, before) {
        // Mark the room read.
        return (changed(after, before).hasOnly(['readAt'])
              && onlyMyKey(after.readAt, before.readAt)
              && after.readAt[request.auth.uid] == request.time)
          // Post a message (written in the same batch as the message itself).
          || (changed(after, before).hasOnly(['lastMessage', 'lastMessageAt', 'readAt'])
              && after.lastMessageAt == request.time
              && after.lastMessage.from == request.auth.uid
              && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/messages/$(after.lastMessage.id))
              && onlyMyKey(after.readAt, before.readAt))
          || (!isDirect(before) && groupUpdate(after, before));
      }

      function groupUpdate(after, before) {
        // Invite people, or cancel an invite.
        return (changed(after, before).hasOnly(['invited', 'invitedEmails']) && validInvites(after))
          || (changed(after, before).hasOnly(['name']) && validName(after.name))
          // Replace the join code (the old one stops working).
          || (changed(after, before).hasOnly(['joinCode'])
              && validCode(after.joinCode)
              && getAfter(docPath('roomCodes', after.joinCode)).data.roomId == roomId)
          || (changed(after, before).hasOnly(['members'])
              && after.members == before.members.removeAll([request.auth.uid]));
      }

      // Accept an invite, or join with the room's code.
      function join(after, before) {
        return changed(after, before).hasOnly(['members', 'invited', 'invitedEmails', 'readAt'])
          && after.members == before.members.concat([request.auth.uid])
          && after.members.size() <= 50
          && after.invited == before.invited.removeAll([request.auth.uid])
          && after.invitedEmails == before.invitedEmails.removeAll([myEmail()])
          && onlyMyKey(after.readAt, before.readAt)
          && (isInvited(before)
              || getAfter(/databases/$(database)/documents/rooms/$(roomId)/joins/$(request.auth.uid)).data.code == before.joinCode);
      }

      function decline(after, before) {
        return isInvited(before)
          && changed(after, before).hasOnly(['invited', 'invitedEmails'])
          && after.invited == before.invited.removeAll([request.auth.uid])
          && after.invitedEmails == before.invitedEmails.removeAll([myEmail()]);
      }

      function isMember() {
        return request.auth.uid in get(roomPath(roomId)).data.members;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && isMember();

        allow create: if signedIn()
          && isMember()
          && request.resource.data.keys().hasOnly([
               'from', 'text', 'url', 'title', 'thumbnail', 'timestampSec', 'createdAt', 'reactions'
             ])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.reactions == {}
          && (request.resource.data.text == null
              || (request.resource.data.text is string
                  && request.resource.data.text.size() >= 1
                  && request.resource.data.text.size() <= 2000))
          && (request.resource.data.url == null
              || (request.resource.data.url is string
                  && request.resource.data.url.size() <= 4096
                  && request.resource.data.url.matches('^https?://.+')
                  && request.resource.data.title is string
                  && request.resource.data.title.size() <= 500))
          && (request.resource.data.text != null || request.resource.data.url != null)
          && (request.resource.data.thumbnail == null
              || (request.resource.data.thumbnail is string && request.resource.data.thumbnail.size() <= 2048))
          && (request.resource.data.timestampSec == null
              || (request.resource.data.timestampSec is int && request.resource.data.timestampSec >= 0));

        // Members react; each person can only set their own reaction.
        allow update: if signedIn()
          && isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && onlyMyKey(request.resource.data.reactions, resource.data.reactions)
          && (!(request.auth.uid in request.resource.data.reactions)
              || (request.resource.data.reactions[request.auth.uid] is string
                  && request.resource.data.reactions[request.auth.uid].size() <= 16));

        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }

      // Proof that someone knows the join code, written in the same batch as joining.
      match /joins/{uid} {
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code is string;
      }
    }

    // Join codes. The document ID is the code; anyone who knows it can look up the room.
    match /roomCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId'])
        && request.auth.uid in getAfter(roomPath(request.resource.data.roomId)).data.members
        && getAfter(roomPath(request.resource.data.roomId)).data.joinCode == code;
      allow delete: if signedIn()
        && request.auth.uid in get(roomPath(resource.data.roomId)).data.members
        && (!existsAfter(roomPath(resource.data.roomId))
            || getAfter(roomPath(resource.data.roomId)).data.joinCode != code);
    }
  }
}
