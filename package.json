{
  "name": "tabs",
  "productName": "Tabs",
  "version": "0.0.3",
  "description": "A Chromium-based browser for sending links to friends in one keystroke.",
  "main": "./out/main/index.js",
  "author": "Sotiris Kaniras",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "deploy:firestore": "firebase deploy --only firestore",
    "test:rules": "firebase emulators:exec --only firestore --project browserr-rules-test \"node tests/rules.test.mjs\"",
    "open:main": "open -n dist/mac-arm64/Tabs.app",
    "open:profile": "open -n dist/mac-arm64/Tabs.app --args --profile=friend",
    "release": "node scripts/release.mjs",
    "app:mac": "electron-vite build && electron-builder --mac --dir --arm64",
    "check-electron": "node scripts/check-electron.mjs",
    "icons": "electron scripts/icons.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.9",
    "tldts": "^7.4.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@fontsource/patrick-hand": "^5.3.0",
    "@ghostery/adblocker-content": "^2.18.2",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "vite": "^7.3.6"
  }
}
